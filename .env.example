POSTGRES_DB=invoice_management
POSTGRES_USER=invoice_app
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
FRONTEND_PORT=5173
DATABASE_URL=jdbc:postgresql://localhost:5432/invoice_management
DATABASE_USERNAME=invoice_app
DATABASE_PASSWORD=change-me
JWT_SECRET=replace-with-at-least-64-high-entropy-characters-before-running
JWT_ISSUER=invoice-management
JWT_AUDIENCE=invoice-management-web
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_COOKIE_SECURE=false
INITIAL_ADMIN_NAME=System Administrator
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
INVOICE_PDF_STORAGE_PATH=./storage/invoices
VITE_API_URL=http://localhost:8080/api/v1
CONTRACT_EXPIRATION_JOB_ENABLED=true
CONTRACT_EXPIRATION_JOB_CRON=0 0 1 * * *
RECURRING_INVOICE_JOB_ENABLED=true
RECURRING_INVOICE_JOB_CRON=0 10 * * * *
